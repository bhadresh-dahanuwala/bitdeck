{
  "name": "bitdeck",
  "version": "0.1.0",
  "description": "Fast bitmask-based playing cards, decks, suits and ranks for TypeScript — built for poker-scale evaluation.",
  "license": "MIT",
  "author": "bhadresh-dahanuwala <bd.noads@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhadresh-dahanuwala/bitdeck.git"
  },
  "homepage": "https://github.com/bhadresh-dahanuwala/bitdeck#readme",
  "bugs": {
    "url": "https://github.com/bhadresh-dahanuwala/bitdeck/issues"
  },
  "keywords": [
    "playing-cards",
    "cards",
    "deck",
    "poker",
    "bitmask",
    "card-game",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "npm run build && vitest bench --run --reporter=verbose",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint && attw --pack .",
    "check": "npm run format:check && npm run build && npm run lint && npm run typecheck && npm run coverage && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
